# ------------------------------------------------------------------
# AI Resume Analyzer - Environment Variables
# Copy this file to `.env` and fill in the real values.
# NEVER commit your real .env file.
# ------------------------------------------------------------------

# Flask
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=1

# Server
HOST=127.0.0.1
PORT=5000

# Google OAuth 2.0 credentials
# Create them at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://127.0.0.1:5000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini API key
# Create one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Uploads
MAX_CONTENT_LENGTH_MB=10

# Database (relative to project root)
DATABASE_PATH=database/app.db
